{
  "manifest_version": 3,
  "name": "Sign Bridge",
  "version": "0.1.0",
  "description": "Lets track.zicha.dev sign PDFs with the qualified certificate on your hardware token.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "externally_connectable": {
    "matches": [
      "https://track.zicha.dev/*",
      "https://beta.track.zicha.dev/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "128": "icon128.png"
  }
}
