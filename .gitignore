.build/
.swiftpm/
.DS_Store
*.xcodeproj

# Local SoftHSM tokens — scripts/softhsm-token.sh makes one on demand, and a
# committed token would be a committed private key.
/tokens/
softhsm2.conf

# Extension build output and anything carrying the signing identity.
extension/dist/
*.p12
*.crx
*.pem
!packaging/**/*.pem

# Release artifacts: the app bundle, the pkg and the staging tree that
# packaging/build-*.sh assemble. Rebuilt from source every time, and the only
# copies that matter are the ones attached to a GitHub release.
/build/
